{
  "model_version": "org-doc-v2",
  "precondition": "The test tenant has administrator admin and revision 1. Requests use a tenant-bound service key and the actor's X-Actor-Id.",
  "steps": [
    {
      "actor": "admin",
      "schema": "WriteRequest",
      "request": {
        "expected_revision": "1",
        "operations": [
          {
            "op": "put_entity",
            "entity": {
              "kind": "user",
              "id": "alice"
            }
          },
          {
            "op": "put_entity",
            "entity": {
              "kind": "user",
              "id": "bob"
            }
          },
          {
            "op": "put_entity",
            "entity": {
              "kind": "document",
              "id": "doc"
            }
          },
          {
            "op": "put_relation",
            "relationship": {
              "resource": {
                "kind": "document",
                "id": "doc"
              },
              "relation": "manager",
              "subject": {
                "kind": "user",
                "id": "alice"
              },
              "subject_relation": ""
            }
          }
        ]
      },
      "expected_http_status": 200,
      "expected_revision": "2"
    },
    {
      "actor": "alice",
      "schema": "WriteRequest",
      "request": {
        "expected_revision": "2",
        "operations": [
          {
            "op": "put_relation",
            "relationship": {
              "resource": {
                "kind": "document",
                "id": "doc"
              },
              "relation": "editor",
              "subject": {
                "kind": "user",
                "id": "bob"
              },
              "subject_relation": ""
            }
          }
        ]
      },
      "expected_http_status": 200,
      "expected_revision": "3"
    },
    {
      "actor": "bob",
      "schema": "CheckRequest",
      "request": {
        "subject": {
          "kind": "user",
          "id": "bob"
        },
        "resource": {
          "kind": "document",
          "id": "doc"
        },
        "action": "edit"
      },
      "expected_http_status": 200,
      "expected_decision": "allow"
    },
    {
      "actor": "bob",
      "schema": "WriteRequest",
      "request": {
        "expected_revision": "3",
        "operations": [
          {
            "op": "put_relation",
            "relationship": {
              "resource": {
                "kind": "document",
                "id": "doc"
              },
              "relation": "manager",
              "subject": {
                "kind": "user",
                "id": "bob"
              },
              "subject_relation": ""
            }
          }
        ]
      },
      "expected_http_status": 403,
      "expected_error": "FORBIDDEN"
    },
    {
      "actor": "alice",
      "schema": "WriteRequest",
      "request": {
        "expected_revision": "3",
        "operations": [
          {
            "op": "delete_relation",
            "relationship": {
              "resource": {
                "kind": "document",
                "id": "doc"
              },
              "relation": "editor",
              "subject": {
                "kind": "user",
                "id": "bob"
              },
              "subject_relation": ""
            }
          }
        ]
      },
      "expected_http_status": 200,
      "expected_revision": "4"
    },
    {
      "actor": "bob",
      "schema": "CheckRequest",
      "request": {
        "subject": {
          "kind": "user",
          "id": "bob"
        },
        "resource": {
          "kind": "document",
          "id": "doc"
        },
        "action": "edit"
      },
      "expected_http_status": 200,
      "expected_decision": "deny"
    }
  ]
}
